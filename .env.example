# Copy to `.env` and fill from `supabase status` after `supabase start`.
# These EXPO_PUBLIC_ vars are inlined into the client bundle by Expo.
#
# The values below are the stable Supabase CLI local defaults; confirm with
# `supabase status`. NOTE: iOS Simulator / Android emulator reach the host
# differently than a physical device:
#   - iOS Simulator:            http://127.0.0.1:54321
#   - Android emulator:         http://10.0.2.2:54321
#   - Physical device (Expo Go): http://<your-LAN-IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
